# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/venture_analyst

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI (required for AI Analysis + Chat; the rest of the app works without it) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
